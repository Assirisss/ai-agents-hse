# Docker Compose: copy to .env in the repository root.
# Compose connects the backend to its own Postgres automatically.
APP_PORT=5173
POSTGRES_PORT=5432
PLANNING_PUBLIC_URL=http://localhost:5173

# Optional project model for trends, wardrobe and planning.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Finance text agent: use a model that supports tool calls.
FINANCE_TEXT_URL=https://openrouter.ai/api/v1
FINANCE_TEXT_MODEL=openrouter/free
FINANCE_TEXT_API_KEY=

# Finance receipt recognition: choose an available vision model.
FINANCE_VISION_URL=https://openrouter.ai/api/v1
FINANCE_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
FINANCE_VISION_API_KEY=
FINANCE_VISION_TIMEOUT_MS=120000

# Optional Telegram bot. Only one running API may poll this token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional Runpod image service and future shared LLM.
RUNPOD_API_KEY=
RUNPOD_BIREFNET_ENDPOINT_ID=
RUNPOD_LLM_ENDPOINT_ID=
RUNPOD_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Optional local Ollama: inside Docker, use the host's address rather than 127.0.0.1.
TREND_LLM_MODEL=
TREND_LLM_URL=http://host.docker.internal:11434
WARDROBE_LLM_URL=http://host.docker.internal:11434
PLANNING_LLM_URL=http://host.docker.internal:11434

# Other optional backend settings are listed in backend/.env.example.
