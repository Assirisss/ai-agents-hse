# Optional local model, used when external API planners are not configured.
TREND_LLM_MODEL=
TREND_LLM_URL=http://127.0.0.1:11434
# Backend binds to loopback by default; Vite proxies /api to it.
PORT=8787
# BiRefNet on Runpod Serverless. Keep this key on the backend only.
RUNPOD_API_KEY=
RUNPOD_BIREFNET_ENDPOINT_ID=
# Future Runpod agent brain. Leave empty to use the OpenRouter API for now.
# When enabled, takes priority over OpenRouter/Ollama; enable workers separately.
# The existing server-side RUNPOD_API_KEY is reused. No automatic provider fallback.
RUNPOD_LLM_ENDPOINT_ID=
RUNPOD_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Personal research memory (kept locally, never committed)
TREND_MEMORY_PATH=data/trends.sqlite
# Sports/nutrition diary works without a model. Its assistant uses Runpod only.
HEALTH_DB_PATH=data/health.sqlite
# Dedicated multimodal vLLM endpoint; never reuse the text-only RUNPOD_LLM_ENDPOINT_ID.
# Empty disables health AI; no OpenRouter/Ollama fallback.
HEALTH_RUNPOD_ENDPOINT_ID=
# Dedicated health-only key takes priority. Empty falls back to RUNPOD_API_KEY for compatibility.
# Restrict only this dedicated key to the health endpoint; preserve other modules' shared-key permissions.
HEALTH_RUNPOD_API_KEY=
HEALTH_RUNPOD_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Persistent global request cap per UTC calendar month, including failed submissions.
# This is a request cap, NOT a dollar spending guarantee. Check Runpod billing separately.
HEALTH_AI_MONTHLY_REQUEST_LIMIT=100
# Optional SearXNG instance with JSON search enabled. Empty uses public Google News RSS; Crossref is also available.
TREND_SEARXNG_URL=

# Optional OpenRouter planner; takes priority over Ollama when a key is present.
# Free router only; no automatic paid fallback. Never use a VITE_ prefix for this key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Wardrobe chat reuses OPENROUTER_API_KEY and OPENROUTER_MODEL by default.
# Optional overrides; no new key is required.
WARDROBE_OPENROUTER_MODEL=
# Local wardrobe model when OpenRouter is not configured (falls back to TREND_LLM_MODEL).
WARDROBE_LLM_MODEL=
WARDROBE_LLM_URL=http://127.0.0.1:11434
# Photo understanding uses the existing OpenRouter key with a separate vision model.
WARDROBE_VISION_MODEL=dots-studio/dots-3-note-preview:free

# Optional model override for trend research only; empty inherits OPENROUTER_MODEL.
TREND_OPENROUTER_MODEL=

# Planning: «Дела и календарь». Credentials for Google, Yandex and Telegram are entered on the website.
# Local model for complex free-text phrases (falls back to TREND_LLM_MODEL, then OpenRouter). PLANNING_LLM=off disables it.
PLANNING_LLM_MODEL=
PLANNING_LLM_URL=http://127.0.0.1:11434
# Address of the website; Google OAuth returns to PLANNING_PUBLIC_URL/api/planning/google/callback.
PLANNING_PUBLIC_URL=http://localhost:5173
PLANNING_DB_PATH=data/planning.sqlite
# Encryption key for stored credentials: 32 bytes in base64. Empty creates data/planning.key.
PLANNING_SECRET_KEY=

# Project Telegram bot from @BotFather. It starts with the service; users only link their chats on the website.
# One token can be polled by one running backend at a time. Never commit the real token.
TELEGRAM_BOT_TOKEN=
