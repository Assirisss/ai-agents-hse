{
  "name": "ai-agents-hse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/finance/migrations', 'dist/backend/src/finance/migrations', { recursive: true })\"",
    "start": "node dist/backend/src/server.js",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "eval:trends": "node --import tsx src/evals/trends.ts",
    "eval:wardrobe": "node --import tsx src/evals/wardrobe.ts",
    "finance:migrate": "node --import tsx src/finance/manage.ts",
    "finance:seed-demo": "node --import tsx src/finance/manage.ts --seed-demo",
    "finance:worker": "node --import tsx src/finance/worker-main.ts",
    "finance:worker:start": "node dist/backend/src/finance/worker-main.js",
    "eval:finance": "node --import tsx --test src/tests/finance-agent.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fastify": "^5.12.7",
    "ical.js": "^2.2.1",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
